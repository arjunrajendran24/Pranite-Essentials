# Public URL of the site (used for canonical URLs, sitemap and Open Graph).
NEXT_PUBLIC_SITE_URL=https://www.praniteessentials.com

# Shopify domain that hosts checkout. When set, "Proceed to payment" hands the cart
# to Shopify's secure hosted checkout via a cart permalink. When empty, checkout runs
# in demo mode (order is saved in the browser only, no payment is taken).
# Use the store's myshopify domain (or a checkout subdomain) once this Next.js site
# takes over www.praniteessentials.com.
NEXT_PUBLIC_SHOPIFY_CHECKOUT_DOMAIN=jx9k0m-fn.myshopify.com
