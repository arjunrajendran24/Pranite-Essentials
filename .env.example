# ---------------------------------------------------------------------------
# Copy to .env.local for local development, and add the same variables in
# Vercel → Project → Settings → Environment Variables (Production + Preview).
# ---------------------------------------------------------------------------

# Public URL of this site (canonical URLs, sitemap, Open Graph).
# Switch to https://www.praniteessentials.com once the domain points at Vercel.
NEXT_PUBLIC_SITE_URL=https://pranite-essentials.vercel.app

# --- Shopify (headless) -----------------------------------------------------
# Products, prices, stock and the cart come from the Shopify Storefront API.
# Checkout is Shopify's hosted checkout (cart.checkoutUrl).

# The store's .myshopify.com domain.
SHOPIFY_STORE_DOMAIN=jx9k0m-fn.myshopify.com

# Shopify-hosted host for checkout / payment (NOT the Vercel marketing domain).
# Required once www points at this Next.js site: add e.g. shop.praniteessentials.com
# in Shopify → Settings → Domains, make it the *primary* domain, then set:
# SHOPIFY_CHECKOUT_DOMAIN=shop.praniteessentials.com
SHOPIFY_CHECKOUT_DOMAIN=

# Storefront API *public* access token (Shopify admin → Headless channel →
# Storefront API). Server-side only: no NEXT_PUBLIC_ prefix, never exposed.
# NEVER put an Admin API token (shpat_…) here.
SHOPIFY_STOREFRONT_ACCESS_TOKEN=

# Storefront API version. Shopify supports each version for 12 months and
# silently upgrades requests for retired ones, so pin a current version.
SHOPIFY_STOREFRONT_API_VERSION=2026-07

# --- Shopify customer accounts ----------------------------------------------
# Customer login ("Account" icon, "Log in" links, /account redirects).
# The store uses Shopify's new customer accounts (passwordless email code / Shop).
NEXT_PUBLIC_SHOPIFY_ACCOUNT_URL=https://shopify.com/76863570134/account

# --- Judge.me product reviews -----------------------------------------------
# Install Judge.me on the Shopify store, then copy tokens from
# Judge.me → Settings → Integrations → View API tokens.
# Private token is server-only — never prefix with NEXT_PUBLIC_.
# Shop domain can be omitted; falls back to SHOPIFY_STORE_DOMAIN.
JUDGEME_SHOP_DOMAIN=jx9k0m-fn.myshopify.com
JUDGEME_PUBLIC_TOKEN=
JUDGEME_PRIVATE_TOKEN=

# --- Review photo uploads (optional) ----------------------------------------
# Judge.me only accepts public image URLs for review photos (not raw uploads).
# Create a Vercel Blob store (Vercel → Storage → Blob, Public access) and ensure
# "Add a read-write token" is checked so this exact name is created:
BLOB_READ_WRITE_TOKEN=
# Text reviews work without this; attaching photos requires it.
